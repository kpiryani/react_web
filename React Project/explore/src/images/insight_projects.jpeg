				<div class="elementor-widget-container">
					<h2 class="elementor-heading-title elementor-size-default">Visual Search</h2>				</div>
				</div>
				<div class="elementor-element elementor-element-9dc3095 elementor-widget elementor-widget-text-editor" data-id="9dc3095" data-element_type="widget" data-widget_type="text-editor.default">
				<div class="elementor-widget-container">
									<p><!--(figmeta)eyJmaWxlS2V5IjoiUGprQzg2b3pXZWRtdlZFYkRzNXdnaiIsInBhc3RlSUQiOi0xLCJkYXRhVHlwZSI6InNjZW5lIn0K(/figmeta)--><!--(figma)(/figma)--><span style="white-space:pre-wrap;">This project aims to analyze how people visually search their environment to create better scanning mechanisms. This project has been a collaboration with the FSA since 2018 and utilizes VR, EEG, and ECG.</span><br></p>								</div>
				</div>
